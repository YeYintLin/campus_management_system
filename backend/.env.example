# Copy to `backend/.env` for local development.
# Never commit real secrets (generate a strong JWT secret for each environment).

PORT=5001

# Pick ONE of the following `MONGODB_URI` values:
# 1) Docker/dev (MongoDB service in compose network)
MONGODB_URI=mongodb://mongo:27017/cms
# 2) MongoDB Atlas (note the database name at the end, e.g. `/cms`)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.yczoc.mongodb.net/cms?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_value

# Optional: local-only integration
OLLAMA_API_URL=http://host.docker.internal:11434

# Seed users (run `npm.cmd --prefix backend run seed:users`)
# For a thesis/demo reset with known passwords, run `npm.cmd --prefix backend run seed:demo`
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_TEACHER_EMAIL=teacher@gmail.com
SEED_TEACHER_PASSWORD=ChangeMeTeacher123!
SEED_STUDENT_EMAIL=student@gmail.com
SEED_STUDENT_PASSWORD=ChangeMeStudent123!
SEED_STUDENT_ENROLLMENT=MECH-2026-001
SEED_STUDENT_DEPARTMENT=Mechatronics Engineering
SEED_STUDENT_SEMESTER=8
SEED_STUDENT_CONTACT=09-000-000-001
# Set to true to overwrite existing users' passwords when seeding
SEED_OVERWRITE_PASSWORDS=false

# Optional: backend health starts before MongoDB connects; this controls DB connect timeout logging.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
