# If someone builds from repo root by accident, keep the build context clean and secret-free.
.git
.gitignore

.env
.env.*

node_modules
**/node_modules

dist
**/dist
build
**/build
.vite
**/.vite
coverage
**/coverage

backend/uploads
backend/uploads/*

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.vscode
.idea
.DS_Store
Thumbs.db

