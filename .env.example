# =================================================================
# Technological University (Hmawbi) Campus Management System
# Production & Development Environment Variable Template (.env.example)
# NOTE: Never commit production credentials or keys to version control.
# =================================================================

# -----------------------------------------------------------------
# 1. Global / Common Service Configuration
# -----------------------------------------------------------------
NODE_ENV=production
JWT_SECRET=
INTERNAL_SERVICE_SECRET=

# -----------------------------------------------------------------
# 2. Database Connection URIs
# -----------------------------------------------------------------
MONGODB_URI_CORE=mongodb://mongo:27017/core_db
MONGODB_URI_ATTENDANCE=mongodb://mongo:27017/attendance_db
MONGODB_URI_AI=mongodb://mongo:27017/ai_db

# -----------------------------------------------------------------
# 3. Microservice Network Endpoints & Ports
# -----------------------------------------------------------------
PORT_GATEWAY=5001
PORT_CORE=5002
PORT_ATTENDANCE=5003
PORT_AI=5004

CORE_SERVICE_URL=http://core-service:5002
ATTENDANCE_SERVICE_URL=http://attendance-service:5003
AI_SERVICE_URL=http://ai-service:5004
OLLAMA_API_URL=http://host.docker.internal:11434

# -----------------------------------------------------------------
# 4. Security & CORS Configuration
# -----------------------------------------------------------------
CORS_ORIGIN=https://campus-management-system-one.vercel.app,http://localhost:5173

# -----------------------------------------------------------------
# 5. Email Service (SMTP) Credentials
# -----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
BUG_REPORT_ADMIN_EMAIL=

# -----------------------------------------------------------------
# 6. Frontend Client (Vite) Variables
# -----------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_DEV_PROXY_TARGET=http://localhost:5001

# -----------------------------------------------------------------
# 7. CI/CD & Production Deployment (GitHub Repository Secrets)
# -----------------------------------------------------------------
VPS_HOST=
VPS_USERNAME=
VPS_SSH_KEY=
VPS_PROJECT_DIR=/var/www/cms
